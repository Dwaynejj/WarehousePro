EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# IMPORTANT: Project URL only — no /rest/v1 or /auth/v1 path.
# Wrong:  https://xxxx.supabase.co/rest/v1
# Right:  https://xxxx.supabase.co

# Machine LAN IP when testing on a physical device (not localhost)
# For production (Vercel), set this to your Render API, e.g.:
# EXPO_PUBLIC_API_BASE_URL=https://warehousepro-7ajh.onrender.com
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8080

# Required only for /admin/invite — keep off public screens
EXPO_PUBLIC_ADMIN_INVITE_CODE=change-me-before-demo

# Google sign-in + password recovery use the Supabase dashboard.
# Auth → URL Configuration → Redirect URLs must include:
#   http://localhost:8081/auth/callback
#   frontend://auth/callback
#   (plus your Expo Go / production URLs as needed)
# Password reset emails also land on /auth/callback, then /(auth)/reset-password.
